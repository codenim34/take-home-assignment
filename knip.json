{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/api": {
      "entry": [
        "src/seed.ts",
        "test/**/*.test.ts"
      ]
    },
    "apps/worker": {
      "entry": [
        "src/index.ts",
        "test/**/*.test.ts"
      ]
    },
    "packages/*": {
      "entry": [
        "src/index.ts",
        "src/testing.ts",
        "src/migrate.ts",
        "test/**/*.test.ts"
      ]
    }
  }
}
