{
  "name": "lomi-review",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev",
    "db:migrate": "pnpm --filter @lomi/db migrate",
    "db:seed": "pnpm --filter @lomi/api seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.20.7",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "turbo": "^2.11.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0"
  }
}
