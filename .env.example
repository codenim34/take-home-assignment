# LLM provider: gemini (default) | anthropic | fake
# "fake" is an offline label matcher for clicking around without a key; it is NOT real extraction.
LLM_PROVIDER=gemini
# Leave empty to use the provider default (gemini-3.8-flash / claude-sonnet-5-5).
LLM_MODEL=

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
