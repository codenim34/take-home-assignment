# LLM provider: gemini (default) | groq | anthropic | fake
# "fake" is an offline label matcher for clicking around without a key; it is NOT real extraction.
LLM_PROVIDER=gemini
# Leave empty for the provider default: gemini-3.8-flash / openai/gpt-oss-20b (groq) / claude-sonnet-5-5.
LLM_MODEL=

GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
