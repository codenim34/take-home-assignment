{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "package.json", "tsconfig*.json", "index.html", "vite.config.ts", "drizzle/**"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "test/**", "tsconfig*.json"]
    },
    "lint": {
      "inputs": ["src/**", "test/**", "../../eslint.config.mjs"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "test/**", "vitest.config.ts"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "test/**", "vitest.config.ts"],
      "env": ["DATABASE_URL", "REDIS_URL"],
      "cache": false
    },
    "dev": { "dependsOn": ["^build"], "cache": false, "persistent": true }
  }
}
